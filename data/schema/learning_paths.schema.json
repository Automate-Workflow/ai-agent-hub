{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Automate-Workflow/ai-agent-hub/blob/main/data/schema/learning_paths.schema.json",
  "title": "AI Agent Hub Learning Path Step",
  "description": "Schema for a single row in data/learning_paths.csv.",
  "type": "object",
  "required": [
    "id",
    "path_name",
    "step",
    "title",
    "objective",
    "prerequisite_ids",
    "concept_ids",
    "resource_ids",
    "estimated_hours",
    "outcome",
    "source_ids",
    "confidence",
    "status",
    "verified_date"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^LP-[0-9]{3}$"
    },
    "path_name": {
      "type": "string",
      "enum": [
        "Foundations",
        "Builder",
        "Architect",
        "Security and Governance",
        "Team Lead"
      ]
    },
    "step": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160
    },
    "objective": {
      "type": "string",
      "minLength": 10,
      "maxLength": 600
    },
    "prerequisite_ids": {
      "type": "string",
      "pattern": "^(LP-[0-9]{3}(\\|LP-[0-9]{3})*|)$"
    },
    "concept_ids": {
      "type": "string",
      "pattern": "^CP-[0-9]{3}(\\|CP-[0-9]{3})*$"
    },
    "resource_ids": {
      "type": "string",
      "pattern": "^RES-[0-9]{3}(\\|RES-[0-9]{3})*$"
    },
    "estimated_hours": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?$"
    },
    "outcome": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500
    },
    "source_ids": {
      "type": "string",
      "pattern": "^SRC-[0-9]{4}(\\|SRC-[0-9]{4})*$"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "needs-review",
        "deprecated"
      ]
    },
    "verified_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
