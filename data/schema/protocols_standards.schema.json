{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Automate-Workflow/ai-agent-hub/blob/main/data/schema/protocols_standards.schema.json",
  "title": "AI Agent Hub Protocol or Standard Entry",
  "description": "Schema for a single row in data/protocols_standards.csv.",
  "type": "object",
  "required": [
    "id",
    "name",
    "kind",
    "steward",
    "purpose",
    "how_it_works",
    "transport_and_auth",
    "adoption_level",
    "strengths",
    "limitations",
    "spec_url",
    "related_concept_ids",
    "source_ids",
    "confidence",
    "status",
    "verified_date",
    "next_review_date"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^PS-[0-9]{3}$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 140
    },
    "kind": {
      "type": "string",
      "enum": [
        "agent_protocol",
        "tool_protocol",
        "api_spec",
        "schema_standard",
        "auth_standard",
        "observability_standard",
        "commerce_protocol",
        "transport_protocol",
        "management_standard"
      ]
    },
    "steward": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160
    },
    "purpose": {
      "type": "string",
      "minLength": 10,
      "maxLength": 600
    },
    "how_it_works": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1200
    },
    "transport_and_auth": {
      "type": "string",
      "minLength": 5,
      "maxLength": 600
    },
    "adoption_level": {
      "type": "string",
      "enum": [
        "widespread",
        "growing",
        "emerging",
        "experimental"
      ]
    },
    "strengths": {
      "type": "string",
      "minLength": 5,
      "maxLength": 800
    },
    "limitations": {
      "type": "string",
      "minLength": 5,
      "maxLength": 800
    },
    "spec_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "maxLength": 2048
    },
    "related_concept_ids": {
      "type": "string",
      "pattern": "^CP-[0-9]{3}(\\|CP-[0-9]{3})*$"
    },
    "source_ids": {
      "type": "string",
      "pattern": "^SRC-[0-9]{4}(\\|SRC-[0-9]{4})*$"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "needs-review",
        "deprecated"
      ]
    },
    "verified_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "next_review_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
