{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Automate-Workflow/ai-agent-hub/blob/main/data/schema/frameworks_tools.schema.json",
  "title": "AI Agent Hub Framework or Tool Entry",
  "description": "Schema for a single row in data/frameworks_tools.csv.",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "maintainer",
    "license",
    "primary_language",
    "open_source",
    "maturity",
    "best_for",
    "not_ideal_for",
    "repo_or_docs_url",
    "supported_protocol_ids",
    "related_concept_ids",
    "source_ids",
    "confidence",
    "status",
    "verified_date",
    "next_review_date"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^FW-[0-9]{3}$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "category": {
      "type": "string",
      "enum": [
        "agent_framework",
        "orchestration",
        "vector_store",
        "observability",
        "evaluation",
        "guardrails",
        "memory",
        "inference",
        "browser_or_computer_use",
        "coding_agent_tool",
        "data_loader"
      ]
    },
    "maintainer": {
      "type": "string",
      "minLength": 2,
      "maxLength": 140
    },
    "license": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "primary_language": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "open_source": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "partial"
      ]
    },
    "maturity": {
      "type": "string",
      "enum": [
        "established",
        "growing",
        "emerging"
      ]
    },
    "best_for": {
      "type": "string",
      "minLength": 5,
      "maxLength": 500
    },
    "not_ideal_for": {
      "type": "string",
      "minLength": 5,
      "maxLength": 500
    },
    "repo_or_docs_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "maxLength": 2048
    },
    "supported_protocol_ids": {
      "type": "string",
      "pattern": "^(PS-[0-9]{3}(\\|PS-[0-9]{3})*|)$"
    },
    "related_concept_ids": {
      "type": "string",
      "pattern": "^CP-[0-9]{3}(\\|CP-[0-9]{3})*$"
    },
    "source_ids": {
      "type": "string",
      "pattern": "^SRC-[0-9]{4}(\\|SRC-[0-9]{4})*$"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "needs-review",
        "deprecated"
      ]
    },
    "verified_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "next_review_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
