{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Automate-Workflow/ai-agent-hub/blob/main/data/schema/evaluation.schema.json",
  "title": "AI Agent Hub Evaluation Entry",
  "description": "Schema for a single row in data/evaluation.csv.",
  "type": "object",
  "required": [
    "id",
    "name",
    "kind",
    "what_it_measures",
    "how_to_run",
    "strengths",
    "limitations",
    "applies_to_type_ids",
    "related_concept_ids",
    "source_ids",
    "confidence",
    "status",
    "verified_date",
    "next_review_date"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^EV-[0-9]{3}$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 140
    },
    "kind": {
      "type": "string",
      "enum": [
        "metric",
        "method",
        "benchmark",
        "tool",
        "process"
      ]
    },
    "what_it_measures": {
      "type": "string",
      "minLength": 10,
      "maxLength": 800
    },
    "how_to_run": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1000
    },
    "strengths": {
      "type": "string",
      "minLength": 5,
      "maxLength": 800
    },
    "limitations": {
      "type": "string",
      "minLength": 5,
      "maxLength": 800
    },
    "applies_to_type_ids": {
      "type": "string",
      "pattern": "^AT-[0-9]{3}(\\|AT-[0-9]{3})*$"
    },
    "related_concept_ids": {
      "type": "string",
      "pattern": "^CP-[0-9]{3}(\\|CP-[0-9]{3})*$"
    },
    "source_ids": {
      "type": "string",
      "pattern": "^SRC-[0-9]{4}(\\|SRC-[0-9]{4})*$"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "needs-review",
        "deprecated"
      ]
    },
    "verified_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "next_review_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
