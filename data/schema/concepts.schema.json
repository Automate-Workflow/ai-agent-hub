{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Automate-Workflow/ai-agent-hub/blob/main/data/schema/concepts.schema.json",
  "title": "AI Agent Hub Concept Entry",
  "description": "Schema for a single row in data/concepts.csv.",
  "type": "object",
  "required": [
    "id",
    "term",
    "category",
    "definition",
    "why_it_matters",
    "how_it_works",
    "common_mistakes",
    "example",
    "related_ids",
    "prerequisite_ids",
    "difficulty",
    "source_ids",
    "confidence",
    "status",
    "verified_date",
    "next_review_date"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CP-[0-9]{3}$"
    },
    "term": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "category": {
      "type": "string",
      "enum": [
        "foundations",
        "reasoning",
        "tools_and_actions",
        "memory_and_knowledge",
        "orchestration",
        "protocols",
        "safety_and_security",
        "evaluation_and_ops",
        "models",
        "interfaces",
        "business"
      ]
    },
    "definition": {
      "type": "string",
      "minLength": 10,
      "maxLength": 280
    },
    "why_it_matters": {
      "type": "string",
      "minLength": 10,
      "maxLength": 800
    },
    "how_it_works": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1200
    },
    "common_mistakes": {
      "type": "string",
      "minLength": 5,
      "maxLength": 800
    },
    "example": {
      "type": "string",
      "minLength": 5,
      "maxLength": 800
    },
    "related_ids": {
      "type": "string",
      "pattern": "^((CP|AT|PT|PS|FW|UC|RS|EV|LP|RES)-[0-9]{3}(\\|(CP|AT|PT|PS|FW|UC|RS|EV|LP|RES)-[0-9]{3})*|)$"
    },
    "prerequisite_ids": {
      "type": "string",
      "pattern": "^(CP-[0-9]{3}(\\|CP-[0-9]{3})*|)$"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "source_ids": {
      "type": "string",
      "pattern": "^SRC-[0-9]{4}(\\|SRC-[0-9]{4})*$"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "needs-review",
        "deprecated"
      ]
    },
    "verified_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "next_review_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
