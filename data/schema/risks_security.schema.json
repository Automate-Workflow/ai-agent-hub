{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Automate-Workflow/ai-agent-hub/blob/main/data/schema/risks_security.schema.json",
  "title": "AI Agent Hub Risk and Security Entry",
  "description": "Schema for a single row in data/risks_security.csv.",
  "type": "object",
  "required": [
    "id",
    "risk",
    "category",
    "description",
    "attack_or_failure_scenario",
    "likelihood",
    "impact",
    "detection",
    "mitigations",
    "related_concept_ids",
    "source_ids",
    "confidence",
    "status",
    "verified_date",
    "next_review_date"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^RS-[0-9]{3}$"
    },
    "risk": {
      "type": "string",
      "minLength": 3,
      "maxLength": 140
    },
    "category": {
      "type": "string",
      "enum": [
        "security",
        "privacy",
        "reliability",
        "cost",
        "legal",
        "ethics",
        "operational"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 800
    },
    "attack_or_failure_scenario": {
      "type": "string",
      "minLength": 10,
      "maxLength": 800
    },
    "likelihood": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "impact": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "detection": {
      "type": "string",
      "minLength": 5,
      "maxLength": 800
    },
    "mitigations": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1000
    },
    "related_concept_ids": {
      "type": "string",
      "pattern": "^CP-[0-9]{3}(\\|CP-[0-9]{3})*$"
    },
    "source_ids": {
      "type": "string",
      "pattern": "^SRC-[0-9]{4}(\\|SRC-[0-9]{4})*$"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "needs-review",
        "deprecated"
      ]
    },
    "verified_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "next_review_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
