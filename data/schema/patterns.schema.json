{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Automate-Workflow/ai-agent-hub/blob/main/data/schema/patterns.schema.json",
  "title": "AI Agent Hub Pattern Entry",
  "description": "Schema for a single row in data/patterns.csv.",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "intent",
    "structure",
    "when_to_use",
    "when_not_to_use",
    "tradeoffs",
    "example",
    "diagram_file",
    "related_concept_ids",
    "related_type_ids",
    "source_ids",
    "confidence",
    "status",
    "verified_date",
    "next_review_date"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^PT-[0-9]{3}$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "category": {
      "type": "string",
      "enum": [
        "workflow",
        "routing",
        "tool_loop",
        "orchestration",
        "quality",
        "safety",
        "memory",
        "retrieval"
      ]
    },
    "intent": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500
    },
    "structure": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1200
    },
    "when_to_use": {
      "type": "string",
      "minLength": 10,
      "maxLength": 800
    },
    "when_not_to_use": {
      "type": "string",
      "minLength": 10,
      "maxLength": 800
    },
    "tradeoffs": {
      "type": "string",
      "minLength": 10,
      "maxLength": 800
    },
    "example": {
      "type": "string",
      "minLength": 10,
      "maxLength": 800
    },
    "diagram_file": {
      "type": "string",
      "pattern": "^(diagrams/[a-z0-9-]+\\.svg|)$"
    },
    "related_concept_ids": {
      "type": "string",
      "pattern": "^CP-[0-9]{3}(\\|CP-[0-9]{3})*$"
    },
    "related_type_ids": {
      "type": "string",
      "pattern": "^AT-[0-9]{3}(\\|AT-[0-9]{3})*$"
    },
    "source_ids": {
      "type": "string",
      "pattern": "^SRC-[0-9]{4}(\\|SRC-[0-9]{4})*$"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "needs-review",
        "deprecated"
      ]
    },
    "verified_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "next_review_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
