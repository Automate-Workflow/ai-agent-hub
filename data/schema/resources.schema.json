{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Automate-Workflow/ai-agent-hub/blob/main/data/schema/resources.schema.json",
  "title": "AI Agent Hub Learning Resource Entry",
  "description": "Schema for a single row in data/resources.csv.",
  "type": "object",
  "required": [
    "id",
    "title",
    "kind",
    "publisher",
    "url",
    "level",
    "free",
    "topics",
    "concept_ids",
    "why_it_helps",
    "source_ids",
    "confidence",
    "status",
    "verified_date",
    "next_review_date"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^RES-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 240
    },
    "kind": {
      "type": "string",
      "enum": [
        "doc",
        "paper",
        "course",
        "book",
        "video",
        "repo",
        "spec",
        "tool",
        "newsletter"
      ]
    },
    "publisher": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "maxLength": 2048
    },
    "level": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "free": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "partial"
      ]
    },
    "topics": {
      "type": "string",
      "minLength": 2,
      "maxLength": 400
    },
    "concept_ids": {
      "type": "string",
      "pattern": "^CP-[0-9]{3}(\\|CP-[0-9]{3})*$"
    },
    "why_it_helps": {
      "type": "string",
      "minLength": 10,
      "maxLength": 600
    },
    "source_ids": {
      "type": "string",
      "pattern": "^SRC-[0-9]{4}(\\|SRC-[0-9]{4})*$"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "needs-review",
        "deprecated"
      ]
    },
    "verified_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "next_review_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
