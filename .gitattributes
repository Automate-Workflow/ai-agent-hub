# Normalize line endings to LF on commit
* text=auto eol=lf

# Explicit text files
*.csv text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.svg text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.txt text eol=lf
*.cff text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.editorconfig text eol=lf
Makefile text eol=lf

# Binary files — no line-ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary

